{
  "name": "tenant-bill-app",
  "version": "1.0.0",
  "description": "Tenant utility bill generator",
  "author": "Satish Jhanwer",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "generate-icon": "node scripts/generate-icon.js",
    "clean": "node scripts/clean.js",
    "build": "npm run clean && npm run generate-icon && vite build && electron-builder --publish never",
    "build:vite": "vite build",
    "preview": "vite preview",
    "postinstall": "node node_modules/electron/install.js"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^44.8.0",
    "electron-builder": "26.15.3",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.tenantbill.app",
    "productName": "Tenant Bill",
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "public/icon.png",
      "maintainer": "${env.MAINTAINER_EMAIL}"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ]
  },
  "packageManager": "yarn@4.18.1"
}
